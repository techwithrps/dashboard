{
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 6 */2 * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/keepalive",
      "destination": "/api/keepalive.py"
    },
    {
      "source": "/api/login",
      "destination": "/api/login.py"
    },
    {
      "source": "/api/metrics",
      "destination": "/api/metrics.py"
    },
    {
      "source": "/api/tally/sync",
      "destination": "/api/tally.py"
    },
    {
      "source": "/api/tally",
      "destination": "/api/tally.py"
    }
  ]
}
